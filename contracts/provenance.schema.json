{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigwright.local/contracts/provenance.schema.json",
  "title": "Rigwright source provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured_utc", "algorithm", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "captured_utc": {"type": "string", "format": "date-time"},
    "algorithm": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "file_count", "total_bytes", "root_sha256", "files"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "file_count": {"type": "integer", "minimum": 0},
          "total_bytes": {"type": "integer", "minimum": 0},
          "root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "bytes", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "bytes": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
