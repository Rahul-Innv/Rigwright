{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigwright.local/contracts/authoring-contract.schema.json",
  "title": "Rigwright atomic neutral skill contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "description", "intent_owner", "intent", "outcome", "non_goals", "inputs", "outputs", "permissions", "triggers", "lifecycle", "instructions", "eval_path", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "intent_owner": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side_effect_class", "allowed_scope", "owner_gates"],
      "properties": {
        "side_effect_class": {"enum": ["read-only", "proposal-write", "live-write"]},
        "allowed_scope": {"type": "string", "minLength": 1},
        "owner_gates": {"type": "array", "items": {"type": "string"}}
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "negative": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "lifecycle": {"$ref": "capability-policy.schema.json#/$defs/lifecycleRecord"},
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "eval_path": {"type": "string", "pattern": "^evals/evals\\.json$"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
