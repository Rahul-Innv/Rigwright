{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigwright.local/contracts/capability-policy.schema.json",
  "title": "Proposed lifecycle and priority contract",
  "$defs": {
    "lifecycleState": {
      "enum": ["current-authorized", "candidate-sandbox", "compatibility-alias", "archived-retained", "quarantined-untrusted", "rejected"]
    },
    "lifecycleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "canonical_owner", "intent_key", "scope", "surfaces", "routing_priority", "specificity", "supersedes", "evidence_date", "promotion_gate"],
      "properties": {
        "state": {"$ref": "#/$defs/lifecycleState"},
        "canonical_owner": {"type": "string", "minLength": 1},
        "intent_key": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["neutral", "claude-code", "codex"]}},
        "routing_priority": {"type": "integer", "minimum": 0, "maximum": 9999},
        "specificity": {"type": "integer", "minimum": 0, "maximum": 100},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_date": {"type": "string", "format": "date"},
        "promotion_gate": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "records": {"type": "array", "items": {"$ref": "#/$defs/lifecycleRecord"}}
  }
}
